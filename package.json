  "scripts": {
    "build:packages": "bunx nx run-many --target=build --projects=m2m-contracts,account-privacy,cookie-banner",
    "e2e:backend:keycloak": "node tools/run-account-backend-keycloak-e2e.mjs",
    "puppeteer:install-browser": "bunx puppeteer browsers install chrome",
    "verify:package:m2m-contracts": "bun tools/verify-package-artifact.mjs dist/libs/m2m-contracts m2m-contracts",
    "verify:package:account-privacy": "bun tools/verify-package-artifact.mjs dist/libs/account-privacy account-privacy",
    "verify:package:cookie-banner": "bun tools/verify-package-artifact.mjs dist/libs/cookie-banner cookie-banner",
    "verify:packages": "bun run verify:package:m2m-contracts && bun run verify:package:account-privacy && bun run verify:package:cookie-banner",
    "publish:m2m-contracts": "bunx nx build m2m-contracts && bun run verify:package:m2m-contracts && cd dist/libs/m2m-contracts && bun publish --access public",
    "publish:account-privacy": "bunx nx build account-privacy && bun run verify:package:account-privacy && cd dist/libs/account-privacy && bun publish --access public",
    "publish:cookie-banner": "bunx nx build cookie-banner && bun run verify:package:cookie-banner && cd dist/libs/cookie-banner && bun publish --access public",
    "publish:packages": "bun run publish:m2m-contracts && bun run publish:account-privacy && bun run publish:cookie-banner"
  },

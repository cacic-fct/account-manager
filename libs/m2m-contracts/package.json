{
  "name": "@cacic-fct/account-manager-m2m-contracts",
  "version": "0.2.1",
  "description": "Framework-agnostic CACiC Account Manager gRPC contracts.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./cjs/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./cjs/index.d.ts",
        "default": "./cjs/index.js"
      },
      "default": "./index.js"
    },
    "./proto/cacic/m2m/account_manager/v1.proto": "./proto/cacic/m2m/account_manager/v1.proto"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacic-fct/account-manager.git",
    "directory": "libs/m2m-contracts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false
}

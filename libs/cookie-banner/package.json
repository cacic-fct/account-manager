{
  "name": "@cacic-fct/cookie-banner",
  "version": "0.0.1",
  "description": "CACiC cookie consent banner with vanilla and Angular entry points.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./angular": {
      "types": "./angular/index.d.ts",
      "default": "./angular/index.js"
    },
    "./styles.css": "./lib/cookie-banner.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacic-fct/account-manager.git",
    "directory": "libs/cookie-banner"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@angular/common": ">=19",
    "@angular/core": ">=19"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css"
  ]
}

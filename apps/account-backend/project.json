{
  "name": "account-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/account-backend/src",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{workspaceRoot}/apps/account-backend/dist"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "main": "apps/account-backend/src/main.ts",
        "tsConfig": "apps/account-backend/tsconfig.build.json",
        "webpackConfig": "apps/account-backend/webpack.config.js",
        "outputPath": "apps/account-backend/dist",
        "outputFileName": "main.js",
        "buildLibsFromSource": true,
        "externalDependencies": "all",
        "generatePackageJson": false,
        "optimization": false,
        "outputHashing": "none",
        "sourceMap": true,
        "typeCheckOptions": {
          "async": false
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run jest --config jest.config.ts"
      }
    },
    "test-watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run jest --watch"
      }
    },
    "test-cov": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run jest --config jest.config.ts --coverage"
      }
    },
    "test-debug": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun exec node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run jest --config ./test/jest-e2e.json --runInBand"
      }
    },
    "e2e-cov": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/account-backend-e2e"],
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run jest --config ./test/jest-e2e.json --runInBand --coverage --coverageDirectory ../../coverage/apps/account-backend-e2e --coverageReporters=json --coverageReporters=lcov --coverageReporters=clover"
      }
    },
    "e2e-keycloak": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run e2e:backend:keycloak"
      }
    },
    "e2e-keycloak-cov": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/account-backend-keycloak-e2e"],
      "options": {
        "command": "bun run e2e:backend:keycloak:cov"
      }
    },
    "integration-seaweedfs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run integration:backend:seaweedfs"
      }
    },
    "integration-seaweedfs-cov": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/account-backend-seaweedfs-integration"],
      "options": {
        "command": "bun run integration:backend:seaweedfs:cov"
      }
    },
    "test-python": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m unittest discover -s apps/account-backend/scripts -p '*_test.py'"
      }
    },
    "test-python-cov": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/account-backend-python"],
      "options": {
        "command": "bun run test:backend:python:cov"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" --fix --no-error-on-unmatched-pattern"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["^build"],
      "cache": false,
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run nest start --watch"
      }
    },
    "serve-prod": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "node dist/main"
      }
    },
    "serve-debug": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["^build"],
      "cache": false,
      "options": {
        "cwd": "apps/account-backend",
        "command": "bun run nest start --debug --watch"
      }
    },
    "setup-python": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/account-backend",
        "command": "cd scripts && chmod +x setup_python_env.sh && ./setup_python_env.sh"
      }
    }
  }
}

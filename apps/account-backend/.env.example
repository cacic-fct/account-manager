# Backend Environment Variables

# Runtime
PORT=3000

# Core application URLs
# BACKEND_URL may be the public origin or the public API base URL.
# OAuth callbacks always use the /api backend prefix.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=https://localhost:4200/app

# Required application secrets and database connection
SESSION_SECRET=your-session-secret-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/account-manager

# Redis configuration for sessions and BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password-here

# CORS and redirect behavior
# CORS_ORIGINS=https://localhost:4200,https://example.com
# ALLOWED_REDIRECT_URLS - URLs where users can be redirected after login
# Format: comma-separated list of absolute URLs or URL origins
# Examples:
# - For external apps: https://eventos.cacic.com.br,https://other-app.example.com
# - For local paths: https://localhost:4200/app/settings/linked-accounts
# If not set, defaults to FRONTEND_URL only
# ALLOWED_REDIRECT_URLS=https://eventos.cacic.com.br,https://localhost:4200
# TRUST_PROXY=1

# S3 configuration for SeaweedFS
S3_ENDPOINT=https://s3.cacic.com.br
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here
S3_BUCKET_NAME=account-manager
S3_REGION=us-east-1

# External Unesp document verification resilience controls
# Set to false and restart the backend to stop new captcha/external queries.
# PDFs entering the captcha routes are queued for manual review instead.
UNIVERSITY_EXTERNAL_VERIFICATION_ENABLED=true
UNIVERSITY_EXTERNAL_TIMEOUT_MS=10000
UNIVERSITY_EXTERNAL_MAX_RESPONSE_BYTES=12582912
UNIVERSITY_EXTERNAL_FAILURE_THRESHOLD=3
UNIVERSITY_EXTERNAL_CIRCUIT_RESET_MS=300000
UNIVERSITY_EXTERNAL_MAX_CONCURRENT_REQUESTS=10
UNIVERSITY_EXTERNAL_SESSION_TTL_MS=900000
UNIVERSITY_EXTERNAL_MAX_SESSIONS=500
# Disabled by default because captcha images and solutions are sensitive data.
CAPTCHA_TRAINING_DATA_ENABLED=false
PDF_VERIFICATION_TIMEOUT_MS=15000
STUDENT_VERIFICATION_PENDING_RETENTION_DAYS=30
STUDENT_VERIFICATION_REJECTED_RETENTION_DAYS=7

# Keycloak configuration
# Local development defaults match docker/docker-compose.keycloak.yml and can be omitted.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cacic-sso
KEYCLOAK_CLIENT_ID=cacic-account-manager
# Required in production unless KEYCLOAK_CLIENT_ID is explicitly a public client.
KEYCLOAK_CLIENT_SECRET=cacic-account-manager-dev-secret
# Optional outside production. Leave empty in development to show Keycloak's
# username/password form. Production always uses google.
KEYCLOAK_LOGIN_IDP_HINT=
# Optional. Development-only. Defaults to true outside production and is always
# disabled in production.
KEYCLOAK_PASSWORD_LOGIN_ENABLED=true
# Defaults to client_secret_basic when KEYCLOAK_CLIENT_SECRET is set.
# Set to client_secret_post only if the Keycloak client policy requires it.
# Set to none only when KEYCLOAK_CLIENT_ID is a public Keycloak client.
# KEYCLOAK_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic

# Keycloak admin client used for updating user attributes
KEYCLOAK_ADMIN_CLIENT_ID=cacic-account-manager-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=cacic-account-manager-admin-client-dev-secret

# Keycloak M2M configuration
# One confidential service-account client should identify this backend when it
# calls other backends. Receiving M2M APIs validate the caller with
# KEYCLOAK_M2M_AUDIENCE and KEYCLOAK_M2M_ALLOWED_CLIENTS below.
KEYCLOAK_M2M_CLIENT_ID=cacic-account-manager-m2m
KEYCLOAK_M2M_CLIENT_SECRET=cacic-account-manager-m2m-dev-secret
KEYCLOAK_M2M_ALLOWED_CLIENTS=cacic-event-manager-m2m,cacic-voto-m2m
KEYCLOAK_M2M_REQUIRE_SERVICE_ACCOUNT=true
KEYCLOAK_M2M_AUDIENCE=cacic-account-manager-audience
JWT_CLOCK_SKEW_TOLERANCE=30

# Event Manager profile update sync
ACCOUNT_MANAGER_GRPC_BIND_URL=0.0.0.0:50051
EVENT_MANAGER_GRPC_URL=event-manager:50051
EVENT_MANAGER_M2M_AUDIENCE=cacic-event-manager-audience
ACCOUNT_MERGE_GRPC_BACKENDS='[{"name":"event-manager","target":"event-manager:50051","audience":"cacic-event-manager-audience"}]'
LGPD_GRPC_BACKENDS='[{"name":"event-manager","category":"event_manager","target":"event-manager:50051","audience":"cacic-event-manager-audience"}]'
LGPD_DELETION_GRPC_BACKENDS='[{"name":"event-manager","target":"event-manager:50051","actions":["schedule","cancel","delete"],"audience":"cacic-event-manager-audience"}]'

# Discord OAuth configuration
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Discord bot configuration
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id
